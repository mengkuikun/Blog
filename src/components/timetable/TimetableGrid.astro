---
import type {
	TimetableCourseView,
	TimetableViewModel,
} from "@/types/timetable";
import TimetableCourseCard from "@components/timetable/TimetableCourseCard.astro";

interface Props {
	viewModel: TimetableViewModel;
	forceVisible?: boolean;
}

const { viewModel, forceVisible = false } = Astro.props;

interface RowBlock {
	startNode: number;
	endNode: number;
	label: string;
	timeText: string;
}

function buildRowBlocks(vm: TimetableViewModel): RowBlock[] {
	const meta = vm.meta;
	const morningNum = meta?.morningNum || 0;
	const afternoonNum = meta?.afternoonNum || 0;
	const nightNum = meta?.nightNum || 0;

	const nodeRows = vm.nodeRows;
	const getNodeRow = (node: number) => nodeRows.find((item) => item.node === node);

	if (morningNum > 0 || afternoonNum > 0 || nightNum > 0) {
		const pairs: { startNode: number; endNode: number }[] = [];
		const sections = [
			{ start: 1, count: morningNum },
			{ start: morningNum + 1, count: afternoonNum },
			{ start: morningNum + afternoonNum + 1, count: nightNum },
		];

		for (const sec of sections) {
			let current = sec.start;
			const end = sec.start + sec.count - 1;
			while (current <= end) {
				if (current + 1 <= end) {
					pairs.push({ startNode: current, endNode: current + 1 });
					current += 2;
				} else {
					pairs.push({ startNode: current, endNode: current });
					current += 1;
				}
			}
		}

		return pairs.map(({ startNode, endNode }) => {
			const startRow = getNodeRow(startNode);
			const endRow = getNodeRow(endNode);
			const label =
				startNode === endNode
					? `第 ${startNode} 节`
					: `第 ${startNode}-${endNode} 节`;
			const timeText = `${startRow?.startTime ?? "--:--"} - ${endRow?.endTime ?? "--:--"}`;
			return { startNode, endNode, label, timeText };
		});
	}

	const maxNode = Math.max(...nodeRows.map((r) => r.node), 1);
	const pairs: RowBlock[] = [];
	for (let node = 1; node <= maxNode; node += 2) {
		const startNode = node;
		const endNode = Math.min(node + 1, maxNode);
		const startRow = getNodeRow(startNode);
		const endRow = getNodeRow(endNode);
		const label =
			startNode === endNode
				? `第 ${startNode} 节`
				: `第 ${startNode}-${endNode} 节`;
		const timeText = `${startRow?.startTime ?? "--:--"} - ${endRow?.endTime ?? "--:--"}`;
		pairs.push({ startNode, endNode, label, timeText });
	}
	return pairs;
}

const dayIndexes = viewModel.dayColumns.map((day) => day.day);
const dayCount = viewModel.dayColumns.length;
const rowBlocks = buildRowBlocks(viewModel);
const courseMapByDayAndBlock = new Map<string, TimetableCourseView[]>();

for (const day of dayIndexes) {
	for (const course of viewModel.coursesByDay[day] ?? []) {
		const matchedBlock =
			rowBlocks.find(
				(b) => course.startNode >= b.startNode && course.startNode <= b.endNode,
			) ?? rowBlocks[0];
		const key = `${day}-${matchedBlock.startNode}`;
		const list = courseMapByDayAndBlock.get(key) ?? [];
		list.push(course);
		courseMapByDayAndBlock.set(key, list);
	}
}
---

<div class="hidden md:block w-full max-w-full overflow-hidden border-b border-white/10" style={`--day-count: ${dayCount}`} data-timetable-scale-root>
	<div class="timetable-scale-viewport" data-timetable-scale-viewport>
		<div class="timetable-scroll-content timetable-scale-content" data-timetable-scale-content>
			<div class="timetable-header-grid border-b border-white/10">
			<div class="px-3 py-2 text-xs text-white border-r border-white/10">节次</div>
			{viewModel.dayColumns.map((day) => (
				<div class="px-3 py-2 text-sm font-semibold text-white border-r last:border-r-0 border-white/10">{day.label}</div>
			))}
		</div>

		{rowBlocks.map((block) => (
			<div class="timetable-row-grid border-b last:border-b-0 border-white/10">
				<div class="px-3 py-3 border-r border-white/10">
					<p class="text-xs text-white font-medium">{block.label}</p>
					<p class="text-[11px] text-white/80 mt-1">{block.timeText}</p>
				</div>
				{viewModel.dayColumns.map((day) => {
					const key = `${day.day}-${block.startNode}`;
					const courses = courseMapByDayAndBlock.get(key) ?? [];
					return (
						<div class="px-2 py-2 border-r last:border-r-0 border-white/10 align-top min-h-[88px]">
							{courses.length > 0 ? (
								<div class="space-y-2">
									{courses.map((course) => (
										<TimetableCourseCard course={course} compact={true} />
									))}
								</div>
							) : (
								<div class="h-full flex items-center justify-center text-[11px] text-white/60">—</div>
							)}
						</div>
					);
				})}
			</div>
		))}
		</div>
	</div>
</div>

<script is:inline>
	function setupTimetableGridScale() {
		const roots = document.querySelectorAll("[data-timetable-scale-root]");
		for (const root of roots) {
			if (!(root instanceof HTMLElement)) continue;
			const viewport = root.querySelector("[data-timetable-scale-viewport]");
			const content = root.querySelector("[data-timetable-scale-content]");
			if (!(viewport instanceof HTMLElement) || !(content instanceof HTMLElement)) continue;

			content.style.setProperty("--timetable-scale", "1");
			viewport.style.setProperty("--timetable-scaled-height", "auto");

			const viewportWidth = viewport.clientWidth;
			const contentWidth = content.scrollWidth;
			if (viewportWidth <= 0 || contentWidth <= 0) continue;

			const scale = Math.min(1, viewportWidth / contentWidth);
			content.style.setProperty("--timetable-scale", String(scale));
			viewport.style.setProperty("--timetable-scaled-height", `${Math.ceil(content.scrollHeight * scale)}px`);
		}
	}

	const runSetupTimetableGridScale = () => {
		requestAnimationFrame(setupTimetableGridScale);
	};

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", runSetupTimetableGridScale, { once: true });
	} else {
		runSetupTimetableGridScale();
	}

	const handlerKey = "__timetableGridScaleHandler";
	const previousHandler = window[handlerKey];
	if (typeof previousHandler === "function") {
		window.removeEventListener("resize", previousHandler);
	}
	window[handlerKey] = runSetupTimetableGridScale;
	window.addEventListener("resize", runSetupTimetableGridScale);
</script>

<style>
	.timetable-scale-viewport {
		width: 100%;
		height: var(--timetable-scaled-height, auto);
		overflow: hidden;
	}

	.timetable-scale-content {
		--timetable-scale: 1;
		transform-origin: top left;
		transform: scale(var(--timetable-scale));
	}

	.timetable-scroll-content {
		width: max(900px, calc(120px + var(--day-count) * 180px));
	}

	.timetable-header-grid,
	.timetable-row-grid {
		display: grid;
		grid-template-columns: 120px repeat(var(--day-count), minmax(180px, 1fr));
	}
</style>
