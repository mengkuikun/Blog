---
import { bangumiConfig } from "@/config";
import BangumiList from "@components/bangumi/BangumiList.svelte";
import PageCardHeader from "@components/misc/PageCardHeader.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getStaticBangumiList } from "@utils/bangumi-utils";

const fallbackList = getStaticBangumiList();

const breadcrumbSchema = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: [
		{
			"@type": "ListItem",
			position: 1,
			name: "首页",
			item: Astro.site,
		},
		{
			"@type": "ListItem",
			position: 2,
			name: "追番",
			item: new URL("/bangumi", Astro.site).toString(),
		},
	],
};
---

<MainGridLayout title="追番">
    <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
    <div class="card-base p-6 md:p-8">
        <PageCardHeader title="追番" pathname="/bangumi/">
            <svg slot="icon" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m17 2l-5 5l-5-5"></path>
                <rect width="20" height="15" x="2" y="7" rx="2" fill="currentColor" stroke="none"></rect>
            </svg>
        </PageCardHeader>

        <!-- 追番交互列表 -->
        <BangumiList client:load fallbackList={fallbackList} userId={bangumiConfig.userId} />
    </div>
</MainGridLayout>
