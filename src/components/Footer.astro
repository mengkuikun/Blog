            感谢
            <a id="cdn-provider-link" class="transition link text-[var(--primary)] font-medium" target="_blank" href="https://www.cloudflare.com/">Cloudflare</a>
            <span id="cdn-provider-desc">提供的 CDN 与 DDoS 防护服务</span>
        </span>
        <br>
        本网站代码
        <a class="transition link text-[var(--primary)] font-medium" target="_blank" href="https://github.com/mengkuikun/Blog">已开源</a>
        <a class="transition link text-white/30 hover:text-[var(--primary)] text-xs ml-1" target="_blank" href={`https://github.com/mengkuikun/Blog/commit/${commitHash}`}>({commitHash} @ {buildDate})</a>
        <br>
    </div>
</div>

<script is:inline>
    (() => {
        function updateCDN(server) {
            const link = document.getElementById("cdn-provider-link");
            const desc = document.getElementById("cdn-provider-desc");
            if (!link) return;

            const s = (server || "").toLowerCase();
            if (s.includes("edgeone") || s.includes("eo") || s.includes("makers")) {
                link.href = "https://edgeone.ai/";
                link.textContent = "腾讯云 EdgeOne";
                if (desc) desc.textContent = "提供的边缘加速与安全防护服务";
            } else if (s.includes("cloudflare") || s.includes("cf")) {
                link.href = "https://www.cloudflare.com/";
                link.textContent = "Cloudflare";
                if (desc) desc.textContent = "提供的 CDN 与 DDoS 防护服务";
            }
        }

        async function detectServer() {
            // Check Dev Mode or Manual Override
            const devServer = localStorage.getItem("dev-server");
            if (devServer) {
                updateCDN(devServer);
                return;
            }

            // Check session cache first for instant render without network lag
            const cached = sessionStorage.getItem("detected_cdn_server");
            if (cached) {
                updateCDN(cached);
                return;
            }

            try {
                const res = await fetch(window.location.href, { method: "HEAD" });
                const serverHeader = res.headers.get("server") || "";
                const isEdgeOne = serverHeader.toLowerCase().includes("edgeone") || 
                                  serverHeader.toLowerCase().includes("makers") ||
                                  res.headers.has("eo-log-uuid") || 
                                  res.headers.has("eo-cache-status");
                const isCloudflare = serverHeader.toLowerCase().includes("cloudflare") || 
                                     res.headers.has("cf-ray");

                let detected = "";
                if (isEdgeOne) {
                    detected = "edgeone";
                } else if (isCloudflare) {
                    detected = "cloudflare";
                } else {
                    detected = serverHeader || "cloudflare";
                }

                sessionStorage.setItem("detected_cdn_server", detected);
                updateCDN(detected);
            } catch (e) {
                // Fallback silently to default
            }
        }

        detectServer();
        document.addEventListener("astro:page-load", detectServer);
        document.addEventListener("content:replace", detectServer);
    })();
</script>
