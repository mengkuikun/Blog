---
import { bangumiConfig } from "@/config";
import BangumiList from "@components/bangumi/BangumiList.svelte";
import Icon from "@components/Icon.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getBangumiList } from "@utils/bangumi-utils";

const bangumiList = await getBangumiList();

const breadcrumbSchema = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: [
		{
			"@type": "ListItem",
			position: 1,
			name: "首页",
			item: Astro.site,
		},
		{
			"@type": "ListItem",
			position: 2,
			name: "追番",
			item: new URL("/bangumi", Astro.site).toString(),
		},
	],
};
---

<MainGridLayout title="追番">
    <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
    <div class="card-base p-6 md:p-8">
        <!-- 页面头部标题 -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 pb-4 border-b border-black/10 dark:border-white/10">
            <div class="flex items-center gap-3">
                <div class="h-10 w-10 rounded-xl bg-[var(--primary)] flex items-center justify-center text-black/80 shadow-md">
                    <Icon name="material-symbols:smart-display-outline-rounded" class="text-[1.75rem]" />
                </div>
                <div>
                    <h1 class="text-2xl font-bold text-neutral-900 dark:text-white">我的追番</h1>
                    <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-0.5">
                        记录二次元番剧生活与观影轨迹
                    </p>
                </div>
            </div>

            <!-- Bangumi 个人主页链接 -->
            {bangumiConfig.enable && bangumiConfig.userId && (
                <a
                    href={`https://bgm.tv/user/${bangumiConfig.userId}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="self-start sm:self-auto flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium text-neutral-700 dark:text-neutral-300 bg-black/5 dark:bg-white/10 hover:bg-[var(--primary)] hover:text-black transition"
                    title="在 Bangumi 查看完整时光机"
                >
                    <span>Bangumi 时光机</span>
                    <Icon name="material-symbols:open-in-new" class="text-sm opacity-70" />
                </a>
            )}
        </div>

        <!-- 追番交互列表 -->
        <BangumiList client:load bangumiList={bangumiList} />
    </div>
</MainGridLayout>
