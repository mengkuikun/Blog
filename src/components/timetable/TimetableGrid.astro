---
import type {
	TimetableCourseView,
	TimetableViewModel,
} from "@/types/timetable";
import TimetableCourseCard from "@components/timetable/TimetableCourseCard.astro";

interface Props {
	viewModel: TimetableViewModel;
	forceVisible?: boolean;
}

const { viewModel, forceVisible = false } = Astro.props;

const dayCount = viewModel.dayColumns.length;
const nodeCount = viewModel.nodeRows.length || 12;

const meta = viewModel.meta;
const morningNum = meta?.morningNum ?? 5;
const afternoonNum = meta?.afternoonNum ?? 4;
const nightNum = meta?.nightNum ?? 3;
---

<div class="hidden md:block w-full max-w-full overflow-hidden border-b border-white/10" style={`--day-count: ${dayCount}; --node-count: ${nodeCount};`} data-timetable-scale-root>
	<div class="timetable-scale-viewport" data-timetable-scale-viewport>
		<div class="timetable-scroll-content timetable-scale-content" data-timetable-scale-content>
			<div class="timetable-grid-layout">
				<!-- 1. Header Corner -->
				<div class="header-corner-cell">
					<span class="text-xs font-semibold text-white/90">节次 / 时间</span>
				</div>

				<!-- 2. Day Column Headers -->
				{viewModel.dayColumns.map((day, dayIndex) => (
					<div
						class="header-day-cell"
						style={`grid-column: ${dayIndex + 2}; grid-row: 1;`}
					>
						<span class="text-sm font-semibold text-white">{day.label}</span>
					</div>
				))}

				<!-- 3. Node Row Headers (Left Y-Axis) -->
				{viewModel.nodeRows.map((row) => {
					const isBreakAfter = row.node === morningNum || row.node === (morningNum + afternoonNum);
					return (
						<div
							class:list={["node-header-cell", { "period-divider-bottom": isBreakAfter }]}
							style={`grid-column: 1; grid-row: ${row.node + 1};`}
						>
							<span class="text-xs font-bold text-white leading-tight">第 {row.node} 节</span>
							<span class="text-[10px] text-white/70 mt-0.5 leading-none">{row.startTime}</span>
							<span class="text-[10px] text-white/45 leading-none">{row.endTime}</span>
						</div>
					);
				})}

				<!-- 4. Background Grid Slots (Grid lines for empty spaces) -->
				{viewModel.nodeRows.map((row) => {
					const isBreakAfter = row.node === morningNum || row.node === (morningNum + afternoonNum);
					return viewModel.dayColumns.map((_, dayIndex) => (
						<div
							class:list={["grid-slot-cell", { "period-divider-bottom": isBreakAfter }]}
							style={`grid-column: ${dayIndex + 2}; grid-row: ${row.node + 1};`}
						/>
					));
				})}

				<!-- 5. Course Cards spanning across their actual durationNodes -->
				{viewModel.dayColumns.map((day, dayIndex) => {
					const courses = viewModel.coursesByDay[day.day] ?? [];
					return courses.map((course) => {
						const col = dayIndex + 2;
						const rowStart = course.startNode + 1;
						const span = Math.max(1, course.durationNodes);
						return (
							<div
								class="course-grid-item"
								style={`grid-column: ${col}; grid-row: ${rowStart} / span ${span};`}
							>
								<TimetableCourseCard course={course} compact={true} />
							</div>
						);
					});
				})}
			</div>
		</div>
	</div>
</div>

<script is:inline>
	function setupTimetableGridScale() {
		const roots = document.querySelectorAll("[data-timetable-scale-root]");
		for (const root of roots) {
			if (!(root instanceof HTMLElement)) continue;
			const viewport = root.querySelector("[data-timetable-scale-viewport]");
			const content = root.querySelector("[data-timetable-scale-content]");
			if (!(viewport instanceof HTMLElement) || !(content instanceof HTMLElement)) continue;

			content.style.setProperty("--timetable-scale", "1");
			viewport.style.setProperty("--timetable-scaled-height", "auto");

			const viewportWidth = viewport.clientWidth;
			const contentWidth = content.scrollWidth;
			if (viewportWidth <= 0 || contentWidth <= 0) continue;

			const scale = Math.min(1, viewportWidth / contentWidth);
			content.style.setProperty("--timetable-scale", String(scale));
			viewport.style.setProperty("--timetable-scaled-height", `${Math.ceil(content.scrollHeight * scale)}px`);
		}
	}

	const runSetupTimetableGridScale = () => {
		requestAnimationFrame(setupTimetableGridScale);
	};

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", runSetupTimetableGridScale, { once: true });
	} else {
		runSetupTimetableGridScale();
	}

	const handlerKey = "__timetableGridScaleHandler";
	const previousHandler = window[handlerKey];
	if (typeof previousHandler === "function") {
		window.removeEventListener("resize", previousHandler);
	}
	window[handlerKey] = runSetupTimetableGridScale;
	window.addEventListener("resize", runSetupTimetableGridScale);
</script>

<style>
	.timetable-scale-viewport {
		width: 100%;
		height: var(--timetable-scaled-height, auto);
		overflow: hidden;
	}

	.timetable-scale-content {
		--timetable-scale: 1;
		transform-origin: top left;
		transform: scale(var(--timetable-scale));
	}

	.timetable-scroll-content {
		width: max(960px, calc(90px + var(--day-count) * 155px));
	}

	.timetable-grid-layout {
		display: grid;
		grid-template-columns: 88px repeat(var(--day-count), minmax(135px, 1fr));
		grid-template-rows: 42px repeat(var(--node-count), 54px);
		border-left: 1px solid rgba(255, 255, 255, 0.1);
		border-top: 1px solid rgba(255, 255, 255, 0.1);
		position: relative;
	}

	.header-corner-cell {
		grid-column: 1;
		grid-row: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		border-right: 1px solid rgba(255, 255, 255, 0.15);
		border-bottom: 2px solid rgba(255, 255, 255, 0.2);
		background: rgba(255, 255, 255, 0.04);
	}

	.header-day-cell {
		display: flex;
		align-items: center;
		justify-content: center;
		border-right: 1px solid rgba(255, 255, 255, 0.1);
		border-bottom: 2px solid rgba(255, 255, 255, 0.2);
		background: rgba(255, 255, 255, 0.04);
	}

	.node-header-cell {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		border-right: 1px solid rgba(255, 255, 255, 0.15);
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
		background: rgba(255, 255, 255, 0.02);
		user-select: none;
	}

	.grid-slot-cell {
		border-right: 1px solid rgba(255, 255, 255, 0.08);
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
		pointer-events: none;
	}

	.period-divider-bottom {
		border-bottom: 2px solid rgba(var(--primary-rgb, 255, 255, 255), 0.35) !important;
	}

	.course-grid-item {
		padding: 3px;
		z-index: 10;
		height: 100%;
		box-sizing: border-box;
	}
</style>
