---
import type { TimetableCourseView } from "@/types/timetable";

interface Props {
	course: TimetableCourseView;
	compact?: boolean;
	showTime?: boolean;
}

const { course, compact = false, showTime = false } = Astro.props;
const borderColor = course.color || "#6b7280";
---

<article class:list={["course-card card-interactive rounded-lg h-full flex flex-col justify-between overflow-hidden", compact ? "p-2" : "p-3"]} style={`--course-color: ${borderColor}`}>
	<div>
		<div class="flex items-center justify-between gap-1 mb-1">
			<span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-semibold leading-none" style={`background: color-mix(in oklab, var(--course-color) 25%, transparent); color: var(--course-color);`}>
				{course.nodeText}
			</span>
			<span class="text-[10px] text-white/75 whitespace-nowrap">{course.startWeek}-{course.endWeek}周</span>
		</div>
		<h3 class:list={["font-bold text-white leading-snug line-clamp-2", compact ? "text-xs" : "text-sm"]}>{course.courseName}</h3>
	</div>
	<div class:list={["space-y-0.5 text-white/80", compact ? "mt-1 text-[11px]" : "mt-2 text-xs"]}>
		{(showTime || course.durationNodes >= 3) && (
			<p class="line-clamp-1"><span class="opacity-70">时间：</span>{course.timeText}</p>
		)}
		<p class="line-clamp-1"><span class="opacity-70">教室：</span>{course.room}</p>
		<p class="line-clamp-1"><span class="opacity-70">教师：</span>{course.teacher}</p>
	</div>
</article>

<style>
	.course-card {
		border-left: 4px solid var(--course-color);
		background: color-mix(in oklab, var(--card-bg) 82%, var(--course-color) 18%);
		box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--course-color) 38%, transparent);
		transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
	}

	:global(.is-focus-mode) .course-card {
		background: color-mix(in oklab, var(--card-bg) 62%, var(--course-color) 38%);
		box-shadow:
			0 0 0 1.5px var(--course-color),
			0 8px 24px -4px color-mix(in oklab, var(--course-color) 45%, transparent),
			inset 0 0 0 1px color-mix(in oklab, var(--course-color) 70%, white 20%);
	}

	:global(.is-focus-mode) .course-card:hover {
		box-shadow:
			0 0 0 2px var(--course-color),
			0 12px 30px -4px color-mix(in oklab, var(--course-color) 65%, transparent);
		transform: translateY(-2px);
	}
</style>
